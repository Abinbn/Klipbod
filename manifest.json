{
  "manifest_version": 3,
  "name": "Klipbod",
  "version": "1.0.0",
  "description": "The ultimate lightweight clipboard manager. Save, view, and manage your copied text and screenshots entirely offline.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "clipboardRead"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
